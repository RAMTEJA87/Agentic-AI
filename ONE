
import os
from openai import OpenAI
from dotenv import load_dotenv

load_dotenv()

client = OpenAI(
    api_key=os.getenv("GROQ_API_KEY"),
    base_url="https://api.groq.com/openai/v1"
)

# Tools
def academic():
    return "Academic information selected."

def exam():
    return "Exam information selected."

def general():
    return "General information selected."

# Agent
def campus_agent(query):

    response = client.chat.completions.create(
        model="openai/gpt-oss-120b",
        messages=[{
            "role": "user",
            "content": f"""Classify this query as Academic, Exam or General.
            Return only the category.
            Query: {query}"""
        }],
        temperature=0
    )

    intent = response.choices[0].message.content.strip().lower()

    print("Intent:", intent)

    if intent == "academic":
        return academic()
    elif intent == "exam":
        return exam()
    else:
        return general()

# Main
while True:
    query = input("\nEnter query (exit to stop): ")

    if query.lower() == "exit":
        break

    try:
        print("Response:", campus_agent(query))
    except Exception as e:
        print("Error:", e)
