
import os
from dotenv import load_dotenv
from typing import TypedDict
from langchain_groq import ChatGroq
from langgraph.graph import StateGraph, START, END

load_dotenv()

llm = ChatGroq(
    model="llama-3.3-70b-versatile",
    api_key=os.getenv("GROQ_API_KEY"),
    temperature=0
)

class State(TypedDict):
    question: str
    code: str

def generate(state):
    response = llm.invoke(
        f"Write Python code for: {state['question']}. Return only code."
    )
    return {"code": response.content}

def check_error(state):
    if "Error" in state["code"] or "Traceback" in state["code"]:
        return "correct"
    return "end"

def correct(state):
    response = llm.invoke(
        f"Correct this code and return only code:\n{state['code']}"
    )
    return {"code": response.content}

graph = StateGraph(State)

graph.add_node("generate", generate)
graph.add_node("correct", correct)

graph.add_edge(START, "generate")

graph.add_conditional_edges(
    "generate",
    check_error,
    {
        "correct": "correct",
        "end": END
    }
)

graph.add_edge("correct", END)

agent = graph.compile()

question = input("Enter your coding question: ")

result = agent.invoke({
    "question": question,
    "code": ""
})

print("\nFinal Code:")
print(result["code"])
